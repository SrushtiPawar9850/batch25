pipeline {
    agent {
    label "node"
    }    
    stages {
        stage('Pull') {
            steps {
                git branch: 'main', url: 'https://github.com/SurajBele/studentdata.git'
                echo"Pull successful"
            }
        }
        stage('Build') {
            steps {
                sh '/opt/apache-maven-3.10.0/bin/mvn clean package'
                echo"Build successful"
            }
        }
        stage('Test') {
            steps {
                echo"Test successful"
            }
        }
        stage('Deploy') {
            steps {
                echo"Deploy successful"
            }
        }
    }
}
